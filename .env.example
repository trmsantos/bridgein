# ── Base de dados ─────────────────────────────────────────────────────────────
POSTGRES_DB=bridgein
POSTGRES_USER=bridgein
POSTGRES_PASSWORD=bridgein
DB_HOST=db
DB_PORT=5432

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── CDN (apenas produção) ─────────────────────────────────────────────────────
# Deixa vazio em dev. Em prod coloca o teu domínio Cloudflare.
# Ex: https://cdn.bridgein.pt  ou  https://bridgein.pt
CDN_URL=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@bridgein.pt
